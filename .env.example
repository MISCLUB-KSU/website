# Supabase — مشروع `mis-club` (فرانكفورت)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ⚠️ مفتاح الخدمة — يتجاوز RLS. لا يُلصق هنا إلا منك، ولا يُرفع إلى git إطلاقًا.
# خذه من: https://supabase.com/dashboard/project/uagqixflyaninffmccqu/settings/api
SUPABASE_SERVICE_ROLE_KEY=

# ── البريد (Resend) ────────────────────────────────────────────────────────
# يرسل بريدين: تأكيدَ وصول الطلب للطالب، ونتيجةَ المراجعة بفعلٍ من اللوحة.
#
# ⚠️ بلا هذا المفتاح **لا شيء يسقط** — يُسجَّل تحذيرٌ في سجلّ الخادم ولا
# يُرسَل بريد. فالتطوير المحلّي والبناء يعملان بدونه.
#
# خذ المفتاح من: https://resend.com/api-keys
RESEND_API_KEY=

# المرسِل — لا بدّ أن يكون على نطاقٍ **موثَّقٍ في Resend**، وإلّا رُفض الإرسال.
# قبل توثيق النطاق استعمل نطاق الاختبار: onboarding@resend.dev
# (يرسل إلى بريد صاحب الحساب وحده — لا يصل الطلاب).
#
# ⚠️ **وهو بريدُ النادي نفسُه لا `no-reply`.** الطالبُ الذي يستلم إيصالًا أو
# نتيجةً قد يردّ عليها بسؤال، و`no-reply` يبتلع ردَّه بلا أثر — ثم يظنّ أنه
# سأل النادي فلم يُجَب. والعنوانُ هنا هو `CONTACT_EMAIL` في
# `src/content/contact.ts`؛ إن غُيّر أحدُهما غُيّر الآخر.
#
# ⚠️ ولا يكفي تغييرُ هذا الملفّ: القيمةُ الفاعلة في **متغيّرات Vercel**،
# وهذا مثالٌ للتطوير المحلّي وحده.
RESEND_FROM="نادي MIS <Info@MisClubKSU.com>"

# ── قناةُ استدراكٍ للطالب بعد الإرسال ──────────────────────────────────────
# رقمُ واتساب يظهر زرًّا في شاشة «وصل طلبك» **لمن لم يرفق سيرةً ذاتية**.
#
# ⚠️ **لا يُكتب في الشيفرة.** رقمٌ شخصيٌّ يبقى في تاريخ `git` للأبد ولو مُحي،
# وتلتقطه الماسحات، ويموت عند تبديل الدورة — فيبقى الموقع يدلّ على من ترك
# النادي. والقيمةُ الفاعلة في **متغيّرات Vercel**، وهذا مثالٌ للتطوير وحده.
#
# ⚠️ وبلا هذا المتغيّر لا يُرسم الزرّ ولا ينكسر شيء — يبقى السطرُ وحدَه.
#
# الصيغة: أرقامٌ فقط بمفتاح الدولة، بلا `+` ولا مسافات.
NEXT_PUBLIC_JOIN_HELP_WHATSAPP=9665XXXXXXXX

# ── المسارُ الحيُّ الذي يسحب منه Excel ──────────────────────────────────────
# `‎/feed.csv?k=<مفتاح>` يخرج جدولَ طلبات جهةٍ واحدة، محدَّثًا لحظةً بلحظة.
# في Excel: Data ← From Web. وفي Google Sheets: ‎=IMPORTDATA("…")
#
# الصيغة: `مفتاح=نطاق` مفصولةً بفواصل. والمفتاحُ يحدّد الجهةَ ولا تُمرَّر
# معه — فلا يبدّل حاملُ الرابط كلمةً فيقرأ جهةً أخرى.
#
# ⚠️ **وهو سرٌّ في عنوان.** من وصله الرابطُ وصلته القائمة — ولذلك لا رقمَ
# أحوالٍ في الجدول أصلًا. ويُبدَّل من متغيّرات Vercel فيموت القديمُ في
# اللحظة. ولّده بـ: openssl rand -hex 24
#
# ⚠️ وبلا هذا المتغيّر يردّ المسارُ 401 على الجميع — والغيابُ آمن.
FEED_TOKENS=6f3c…=project:impact,9ab1…=committee:media
